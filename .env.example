# Bearer key(s) our server accepts (comma-separated for several).
OSO_API_KEY=

# OpenRouter: chat-completions profiles AND the Jev baseline (OpenRouter's System One API).
OPENROUTER_API_KEY=

# Hugging Face Inference Endpoint profiles. Base URL with /v1 appended,
# e.g. https://xxxxxxxx.us-east-1.aws.endpoints.huggingface.cloud/v1
HF_ENDPOINT_URL=
HF_TOKEN=

# Ollama (local profiles).
OLLAMA_HOST=http://localhost:11434
